DB_SERVER=SERVIDOR_BASE_DE_DATOS,PUERTO
DB_NAME=NOMBRE_BASE_DE_DATOS
DB_USER=USUARIO_DE_BASE_DE_DATOS
DB_PASSWORD=CONTRASEÑA_DE_BASE_DE_DATOS
DB_TRUST_CERT=True
# JWT
JWT_SECRET=CLAVE_SECRETA_DE_AL_MENOS_32_CARACTERES
JWT_ISSUER=BackendSystem
JWT_AUDIENCE=BackendClients
JWT_EXPIRE_MINUTES=60

# Usuario admin inicial (solo se usa la primera vez, si no existe). 8+ caracteres con letras y números.
# Si se deja vacío, se genera una contraseña aleatoria y se muestra una sola vez en la consola.
ADMIN_PASSWORD=

# Registro público de usuarios (true/false). Por defecto cerrado: el alta la hace un admin.
REGISTRO_PUBLICO=false
